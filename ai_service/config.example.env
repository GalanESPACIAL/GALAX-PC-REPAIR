# Plantilla de configuración. NO contiene secretos reales.
# Copia este archivo y exporta las variables en tu shell antes de arrancar.
# Este servicio NO carga automáticamente archivos .env (usa el entorno del proceso).

# Ruta local del modelo (sin copiar ni mover los safetensors).
# Usa barras forward para evitar problemas de escapado en shells.
GEMMA_MODEL_PATH=D:/GAlAX PC REPAIR/gemma-4-E4B-it

# Token obligatorio para POST /chat. Sustituye por un valor aleatorio largo.
# Si no se define, /chat se rechaza con 503 (fail-closed).
GEMMA_API_TOKEN=REEMPLAZAR_CON_TOKEN_LARGO_ALEATORIO

# Escucha local por defecto; exponer en 0.0.0.0 sólo detrás de un proxy/TLS.
GEMMA_HOST=127.0.0.1
GEMMA_PORT=8501

# Segundos máximos por petición (1..3600). El modelo en CPU puede ser lento.
GEMMA_TIMEOUT=300

# Valor por defecto de max_new_tokens cuando el cliente no lo envía (64..1024).
GEMMA_MAX_NEW_TOKENS=512

# auto | bfloat16 | float16 | float32. "auto" respeta el dtype del config.json.
GEMMA_DTYPE=auto
