# GALAX PC REPAIR — Configuración de Supabase
# Copia este archivo como .env y completa los valores de tu proyecto.
# NUNCA subas el archivo .env a GitHub (ya está excluido en .gitignore).

# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_SOLO_SERVIDOR

# --- Conexión directa a PostgreSQL (Project Settings -> Database) ---
# Usa el pooler (puerto 6543) para la app web.
SUPABASE_DB_HOST=aws-0-TU-REGION.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.TU-PROYECTO
SUPABASE_DB_PASS=TU_PASSWORD_DE_BASE_DE_DATOS

# --- Sitio ---
GALAX_SITE_URL=http://localhost/galax_pc_repair
GALAX_SITE_NAME=GALAX PC REPAIR

# --- Servicio IA local (opcional) ---
GEMMA_API_TOKEN=
